# FORZAR HTTPS y WWW
RewriteEngine On

# 1. Redirigir http a https
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Redirigir non-www a www
RewriteCond %{HTTP_HOST} ^codigoamigo\.com$ [NC]
RewriteRule ^(.*)$ https://www.codigoamigo.com/$1 [R=301,L]

# Configuración SEO-Friendly y de Rendimiento
# Cache-Control mejorado para SEO y rendimiento
# Archivos estáticos: caché largo para mejor SEO
<FilesMatch "\.(jpg|jpeg|png|gif|webp|ico|css|js|woff|woff2|ttf|svg)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
</FilesMatch>

# Páginas HTML: caché moderado para SEO
<FilesMatch "\.(html|php)$">
    Header set Cache-Control "max-age=3600, public"
    Header set Vary "Accept-Encoding"
</FilesMatch>

# Compresión GZIP para reducir tamaño de transferencia (60-80% menos)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/ld+json
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml
    AddOutputFilterByType DEFLATE font/woff font/woff2 font/ttf font/otf
    AddOutputFilterByType DEFLATE image/svg+xml image/x-icon
</IfModule>

# Security & Performance headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# URL Rewriting para páginas amigables
# Redirigir todas las URLs que no sean archivos existentes a index.php
RewriteRule ^test-rw/([^/]+)/?$ test_rewrite.php?slug=$1 [L,QSA]
RewriteRule ^go/(.*)$ redirect_amazon.php?slug=$1 [L,QSA]
RewriteRule ^amazon/([^/]+)/?$ amazon_service_detail.php?slug=$1 [L,QSA]
RewriteRule ^amazon/?$ amazon_services.php [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]