        ],
        'hogar-y-jardin-comparte-y-gana' => [
            'nombre' => 'Hogar y Jardín',
            'descripcion' => 'Ahorra en muebles, decoración, electrodomésticos, herramientas de jardín y productos para el hogar.',
            'icono' => 'fas fa-home'
        ],
        'deportes-y-ocio-comparte-y-gana' => [
