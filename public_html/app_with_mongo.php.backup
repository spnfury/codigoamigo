                break;
        }
    } else {
        debug_log("No hay parámetro orden, usando orden por defecto");
    }

    

    $sort_order_destacados = array('destacado_social' => -1, 'destacado' => -1, 'fecha_publicacion' => -1);

        /* Listado PATROCINADOS/DESTACADOS */
        $array_filtro = array("estado" => 0);
        $array_filtro = array_merge($array_filtro, array(
            '$or' => array(
