$isApiRequest = strpos($uri, '/ajax') === 0 ||
               strpos($uri, '/api') === 0 ||
               strpos($uri, '/test-slim') === 0 ||
               strpos($uri, '/myphp/ajax') === 0 ||
               $_SERVER['REQUEST_METHOD'] === 'POST';

// Ejecutar la aplicación con manejo de errores
try {
    $app->run();
} catch (Exception $e) {
    error_log("Error ejecutando aplicación Slim: " . $e->getMessage() . " en " . $e->getFile() . ":" . $e->getLine());
    error_log("Stack trace: " . $e->getTraceAsString());

    // Si hay un error crítico, mostrar página de error
    if (!headers_sent()) {
        http_response_code(500);
        echo "Error interno del servidor";
    }
    exit;
}

