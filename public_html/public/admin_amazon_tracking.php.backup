</head>
<body>
    <div class="container">
        <h1>🔍 Dashboard Amazon - Monitoreo de Afiliados</h1>
        <p class="subtitle">Monitorea todos los clicks en enlaces de Amazon y verifica que se estén aplicando correctamente los tags de afiliado</p>
        
        <!-- Filtros -->
        <div class="filters">
            <div class="filter-group">
                <label for="filtro_fecha">Período:</label>
                <select id="filtro_fecha" name="fecha">
                    <option value="hoy" <?php echo $filtro_fecha === 'hoy' ? 'selected' : ''; ?>>Hoy</option>
