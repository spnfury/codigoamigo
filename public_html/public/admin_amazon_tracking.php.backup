                <div class="stat-value"><?php echo $tasa_exito; ?>%</div>
                <div class="stat-detail">
                    <?php if ($tasa_exito >= 95): ?>
                        ✅ Excelente
                    <?php elseif ($tasa_exito >= 80): ?>
