                    <?php endif; ?>
                </div>
            </div>
            
            <div class="stat-card info">
                <div class="stat-label">ASINs Únicos</div>
                <div class="stat-value"><?php echo count($asins_unicos); ?></div>
                <div class="stat-detail">Productos diferentes</div>
            </div>
        </div>
        
        <!-- Tabla de clicks -->
        <div class="clicks-table">
            <div class="table-header">
                <h2>Detalle de Clicks Recientes</h2>
            </div>
            
            <?php if (count($clicks) > 0): ?>
            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>Fecha/Hora</th>
                            <th>Chollo</th>
                            <th>Amazon</th>
                            <th>Tag Afiliado</th>
                            <th>ASIN</th>
                            <th>IP</th>
                            <th>URL Final</th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php foreach ($clicks as $click): 
                            // Obtener datos del chollo
                            $chollo = null;
                            if (isset($click['chollo_id'])) {
                                try {
                                    $chollo = obtenerCholloPorId((string)$click['chollo_id'], false);
                                } catch (Exception $e) {
                                    // Ignorar
                                }
                            }
                            
                            $fecha_click = $click['fecha']->toDateTime()->setTimezone(new DateTimeZone('Europe/Madrid'));
                            
                            // Determinar si esta fila debe resaltarse en rojo
                            $es_amazon = isset($click['es_amazon']) && $click['es_amazon'];
                            $tiene_tag = isset($click['tiene_tag_afiliado']) && $click['tiene_tag_afiliado'];
                            $sin_tag_class = ($es_amazon && !$tiene_tag) ? ' sin-tag-afiliado' : '';
                        ?>
                        <tr class="<?php echo $sin_tag_class; ?>">
                            <td><?php echo $fecha_click->format('d/m/Y H:i:s'); ?></td>
                            <td>
                                <?php if ($chollo): ?>
                                    <a href="/chollos/<?php echo (string)$click['chollo_id']; ?>" target="_blank" style="color: #3498db; text-decoration: none;">
                                        <?php echo htmlspecialchars(mb_substr($chollo['titulo'] ?? 'Sin título', 0, 50)); ?>...
                                    </a>
                                <?php else: ?>
                                    <span style="color: #95a5a6;">ID: <?php echo substr((string)$click['chollo_id'], -8); ?></span>
                                <?php endif; ?>
                            </td>
                            <td>
                                <?php if (isset($click['es_amazon']) && $click['es_amazon']): ?>
                                    <span class="badge badge-info">✓ Amazon</span>
                                <?php else: ?>
                                    <span class="badge">Otro</span>
                                <?php endif; ?>
                            </td>
                            <td>
                                <?php if (isset($click['tiene_tag_afiliado']) && $click['tiene_tag_afiliado']): ?>
                                    <span class="badge badge-success">✓ Con Tag</span>
                                <?php elseif (isset($click['es_amazon']) && $click['es_amazon']): ?>
                                    <span class="badge badge-danger">✗ Sin Tag</span>
                                <?php else: ?>
                                    <span class="badge">N/A</span>
                                <?php endif; ?>
                            </td>
                            <td>
                                <?php if (isset($click['asin'])): ?>
                                    <span class="asin-badge"><?php echo htmlspecialchars($click['asin']); ?></span>
                                <?php else: ?>
                                    <span style="color: #95a5a6;">-</span>
                                <?php endif; ?>
                            </td>
                            <td><?php echo htmlspecialchars($click['ip'] ?? 'unknown'); ?></td>
                            <td class="url-cell" title="<?php echo htmlspecialchars($click['enlace_final'] ?? ($click['enlace_original'] ?? '')); ?>">
                                <?php echo htmlspecialchars($click['enlace_final'] ?? ($click['enlace_original'] ?? '-')); ?>
                            </td>
                        </tr>
                        <?php endforeach; ?>
                    </tbody>
                </table>
            </div>
            <?php else: ?>
            <div class="empty-state">
                <div class="empty-state-icon">📊</div>
                <h3>No hay clicks registrados</h3>
                <p>No se encontraron clicks en el período seleccionado</p>
            </div>
            <?php endif; ?>
        </div>
    </div>
    
    <script>
        function aplicarFiltros() {
            const fecha = document.getElementById('filtro_fecha').value;
            const soloAmazon = document.getElementById('solo_amazon').checked ? '1' : '0';
            
            window.location.href = `?fecha=${fecha}&solo_amazon=${soloAmazon}`;
        }
        
        // Auto-actualizar cada 30 segundos
        setTimeout(() => {
            location.reload();
        }, 30000);
    </script>
</body>
</html>
