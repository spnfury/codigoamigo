# Configuración específica para el panel de logs
# Permite acceso a directorios de logs del sistema

<IfModule mod_php.c>
    php_admin_value open_basedir none
</IfModule>

<IfModule mod_php7.c>
    php_admin_value open_basedir none
</IfModule>

<IfModule mod_php8.c>
    php_admin_value open_basedir none
</IfModule>

# Configuraciones adicionales para el panel de logs
php_value max_execution_time 60
php_value memory_limit 256M
php_value post_max_size 50M
php_value upload_max_filesize 50M